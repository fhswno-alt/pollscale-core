# Copy to .env for docker compose / local API.

# Postgres (used by docker compose). Leave unset to use local SQLite.
DATABASE_URL=postgresql+psycopg2://pollscale:pollscale@db:5432/pollscale

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30

# Public URL of the API (used for local media URLs)
PUBLIC_BASE_URL=http://localhost:8000

# Auto-insert seed polls when the database is empty
AUTO_SEED=true

# Allow the Apple/Google buttons to complete a local identity
# without real IdP credentials (TestFlight / internal).
ALLOW_DEV_AUTH=true

# Apple Sign In (optional until you have a Services ID)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Google Sign In (optional until you have a Web client ID)
GOOGLE_CLIENT_ID=

# Hetzner S3-compatible object storage.
# If these are empty, images are stored on the local filesystem (or MinIO).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pollscale
S3_REGION=fsn1
S3_PUBLIC_URL=
S3_USE_SSL=true

# Local filesystem fallback
MEDIA_DIR=/data/media
