DATABASE_URL=postgresql+psycopg2://pollscale:pollscale@localhost:5432/pollscale
POLLSCALE_ENV=development
JWT_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost:8000
AUTO_SEED=true

# Must be explicit. Leave false in production. Set true only on a local machine.
ALLOW_DEV_AUTH=false

# First admin (email + password). MFA is enrolled on first login.
ADMIN_BOOTSTRAP_EMAIL=dave@pollscale.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

OPENAI_API_KEY=
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pollscale
S3_REGION=fsn1
S3_PUBLIC_URL=
MEDIA_DIR=./apps/api/data/media

SLACK_WEBHOOK_URL=
